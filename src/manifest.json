{
  "manifest_version": 3,
  "name": "GitubGen V2 - KPI Extractor",
  "version": "0.6.0",
  "description": "Rekonsiliasi DSM, timeline GitHub, parent/sub-issue, dan KPI Excel.",
  "permissions": ["storage", "tabs", "downloads", "sidePanel"],
  "host_permissions": ["https://github.com/*", "https://api.github.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Buka GitubGen V2"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*/*/issues/*", "https://github.com/*/*/pull/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
